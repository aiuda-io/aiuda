#!/usr/bin/env python3
"""wacli FALSO para pruebas. No habla con WhatsApp ni con la red.

Imita la superficie que usa aiuda (auth, auth status, auth logout, sync --follow,
send text/file, chats list, messages list, doctor), su JSON, sus eventos NDJSON
por stderr y su candado: flock sobre <store>/LOCK, que el sistema suelta cuando
el proceso muere. Exige --store: jamás cae al ~/.wacli de nadie.

La prueba lo maneja con archivos dentro del store:
  escanear        el `auth` en curso se da por emparejado
  cerrar_sesion   el `sync` en curso emite logged_out y sale con 0
  morir           el `sync` en curso sale con 3 sin avisar
  fallar_envio    su contenido es el error del siguiente `send` (se queda puesto)
Lo que "sale" queda en enviados.jsonl; cada arranque de sync en arranques.log.
"""

import fcntl
import json
import os
import signal
import sys
import time

argv = sys.argv[1:]


def flag(nombre, default=None):
    if nombre in argv:
        i = argv.index(nombre)
        return argv[i + 1] if i + 1 < len(argv) else default
    return default


def segundos(texto, default):
    if not texto:
        return default
    for sufijo, factor in (("ms", 0.001), ("s", 1), ("m", 60)):
        if texto.endswith(sufijo):
            return float(texto[: -len(sufijo)]) * factor
    return float(texto)


if "--version" in argv:
    print("wacli 0.20.0")
    sys.exit(0)

STORE = flag("--store")
if not STORE:
    print("wacli falso: falta --store", file=sys.stderr)
    sys.exit(2)
os.makedirs(STORE, exist_ok=True)
JSON = "--json" in argv
EVENTS = "--events" in argv


def ruta(nombre):
    return os.path.join(STORE, nombre)


def evento(nombre, data=None):
    if EVENTS:
        linea = {"event": nombre, "ts": int(time.time() * 1000)}
        if data is not None:
            linea["data"] = data
        print(json.dumps(linea), file=sys.stderr, flush=True)


def salir_ok(data):
    if JSON:
        print(json.dumps({"success": True, "data": data, "error": None}))
    sys.exit(0)


def salir_error(mensaje, codigo=1):
    if JSON:
        print(json.dumps({"success": False, "data": None, "error": mensaje}), file=sys.stderr)
    else:
        print(mensaje, file=sys.stderr)
    sys.exit(codigo)


def sesion():
    try:
        with open(ruta("session.json")) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def autenticado():
    return bool(sesion().get("authenticated"))


_candado = None


def _intentar_candado():
    global _candado
    fh = open(ruta("LOCK"), "a+")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        fh.close()
        return False
    fh.seek(0)
    fh.truncate()
    fh.write(f"pid={os.getpid()}\nacquired_at={time.strftime('%Y-%m-%dT%H:%M:%SZ')}\n")
    fh.flush()
    _candado = fh
    return True


def dueno_del_candado():
    try:
        with open(ruta("LOCK")) as fh:
            return fh.read().strip().replace("\n", " ")
    except OSError:
        return ""


def tomar_candado():
    espera = segundos(flag("--lock-wait"), 0)
    fin = time.monotonic() + espera
    while True:
        if _intentar_candado():
            return
        if time.monotonic() >= fin:
            break
        time.sleep(0.1)
    detalle = f"store locked: {ruta('LOCK')} ({dueno_del_candado()})"
    if espera:
        salir_error(f"timed out waiting for store lock after {flag('--lock-wait')}: {detalle}")
    salir_error(f"store is locked (another wacli is running?): {detalle}")


def candado_tomado():
    """¿Otro proceso tiene el candado? (Se prueba tomándolo y soltándolo.)"""
    fh = open(ruta("LOCK"), "a+")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return True
    finally:
        fh.close()
    return False


def consumir(nombre):
    try:
        os.remove(ruta(nombre))
        return True
    except OSError:
        return False


posicionales = [a for a in argv if not a.startswith("-")]
cmd = posicionales[0] if posicionales else ""
sub = posicionales[1] if len(posicionales) > 1 else ""

if cmd == "auth" and sub == "status":
    s = sesion()
    data = {"authenticated": bool(s.get("authenticated"))}
    if data["authenticated"]:
        data["phone"] = s.get("phone", "5215500000001")
        data["linked_jid"] = data["phone"] + "@s.whatsapp.net"
    salir_ok(data)

if cmd == "auth" and sub == "logout":
    if not autenticado():
        salir_error("not authenticated; run `wacli auth`")
    tomar_candado()
    os.remove(ruta("session.json"))
    salir_ok({"logged_out": True})

if cmd == "auth":
    tomar_candado()
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    evento("auth_starting")
    rotar = float(os.environ.get("WACLI_FALSO_QR_ROTA", "2"))
    caduca = time.monotonic() + float(os.environ.get("WACLI_FALSO_QR_CADUCA", "60"))
    n = 0
    proxima = 0.0
    while not consumir("escanear"):
        ahora = time.monotonic()
        if ahora >= caduca:
            evento("error", {"message": "QR code timed out"})
            salir_error("QR code timed out; run `wacli auth` again to get a new code")
        if ahora >= proxima:
            n += 1
            evento("qr_code", {"code": f"QR-FALSO-{n}"})
            proxima = ahora + rotar
        time.sleep(0.1)
    with open(ruta("session.json"), "w") as fh:
        json.dump({"authenticated": True, "phone": "5215500000001"}, fh)
    evento("connected")
    time.sleep(min(segundos(flag("--idle-exit"), 0.5), 1.0))  # el bootstrap, abreviado
    evento("idle_exit")
    sys.exit(0)

if cmd == "sync":
    if not autenticado():
        salir_error("not authenticated; run `wacli auth`")
    tomar_candado()
    with open(ruta("arranques.log"), "a") as fh:
        fh.write(f"{os.getpid()}\n")

    def _terminar(*_):
        evento("stopping", {"reason": "signal"})
        sys.exit(0)

    signal.signal(signal.SIGTERM, _terminar)
    signal.signal(signal.SIGINT, _terminar)
    time.sleep(float(os.environ.get("WACLI_FALSO_CONECTA", "0.2")))
    evento("connected")
    while True:
        if consumir("cerrar_sesion"):
            os.remove(ruta("session.json"))
            evento("logged_out", {"reason": "device_removed", "reason_code": 401})
            evento("stopping", {"reason": "logged_out"})
            sys.exit(0)
        if consumir("morir"):
            print("reconnect failed: websocket: close 1006", file=sys.stderr, flush=True)
            sys.exit(3)
        time.sleep(0.1)

if cmd == "send" and sub in ("text", "file"):
    if not autenticado():
        salir_error("not authenticated; run `wacli auth`")
    tomar_candado()
    try:
        with open(ruta("fallar_envio")) as fh:
            salir_error(fh.read().strip() or "not connected")
    except OSError:
        pass
    registro = {
        "tipo": sub,
        "to": flag("--to"),
        "message": flag("--message"),
        "file": flag("--file"),
        "caption": flag("--caption"),
        "filename": flag("--filename"),
        "id": f"FALSO{int(time.time() * 1000)}",
    }
    with open(ruta("enviados.jsonl"), "a") as fh:
        fh.write(json.dumps(registro) + "\n")
    if not JSON:
        print(f"Sent to {registro['to']} (id {registro['id']})")
    salir_ok({"sent": True, "to": registro["to"], "id": registro["id"]})

if cmd == "chats" and sub == "list":
    try:
        with open(ruta("chats.json")) as fh:
            salir_ok(json.load(fh))
    except (OSError, ValueError):
        salir_ok(None)

if cmd == "messages" and sub == "list":
    try:
        with open(ruta("mensajes.json")) as fh:
            mensajes = json.load(fh).get(flag("--chat"), [])
    except (OSError, ValueError):
        mensajes = None
    salir_ok({"fts": False, "messages": mensajes})

if cmd == "doctor":
    salir_ok(
        {
            "store_dir": STORE,
            "lock_held": candado_tomado(),
            "authenticated": autenticado(),
            "connected": False,
        }
    )

salir_error(f"unknown command: {' '.join(argv)}", 2)
